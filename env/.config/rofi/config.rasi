@import "~/.config/rofi/theme.rasi"

configuration {
  drun-display-format: "{name}";
  display-drun: "";
  show-icons: true;
}

* {
  background-color: transparent;
  text-color: @fg;
  font: "GeistMono Nerd Font Medium 11";
  spacing: 0;
}

window {
  background-color: @bg-alt;
  border: 1px solid;
  border-color: @border;
  border-radius: 10px;
  padding: 0;
  width: 34%;
  location: center;
  y-offset: 0;
}

mainbox {
  padding: 8px;
  spacing: 8px;
  border: 0;
}

inputbar {
  padding: 6px 10px 10px 10px;
  spacing: 8px;
  background-color: transparent;
  text-color: @fg;
  border: 0px 0px 1px 0px solid;
  border-color: @border;
  margin: 0;
  children: [ prompt, entry ];
}

prompt {
  enabled: true;
  text-color: @prompt;
  str: " ";
  vertical-align: 0.5;
}

entry {
  text-color: @fg;
  placeholder-color: @info;
  placeholder: "Search…";
  vertical-align: 0.5;
}

case-indicator {
  enabled: false;
}

listview {
  padding: 4px 0px;
  spacing: 6px;
  lines: 6;
  fixed-height: true;
  scrollbar: false;
  border: 0;
  dynamic: false;
}

element {
  padding: 6px 10px;
  spacing: 10px;
  border: 0;
  border-radius: 10px;
  background-color: transparent;
  text-color: @fg;
}

element normal.normal {
  background-color: transparent;
  text-color: @fg;
}

element alternate.normal {
  background-color: transparent;
  text-color: @fg;
}

element selected.normal {
  background-color: @bg-selected;
  text-color: @fg;
}

element-text {
  background-color: transparent;
  text-color: inherit;
  vertical-align: 0.5;
  highlight: bold underline;
}

element-icon {
  background-color: transparent;
  size: 1.2em;
  text-color: inherit;
  vertical-align: 0.5;
}

message {
  padding: 8px 12px;
  background-color: @bg-alt;
  text-color: @fg;
  border: 0;
  margin: 0;
  border-radius: 10px;
}

textbox {
  text-color: @fg;
}

scrollbar {
  enabled: false;
}

sidebar {
  enabled: false;
}

button {
  enabled: false;
}

mode-switcher {
  enabled: false;
}
