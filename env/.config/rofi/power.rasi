@import "~/.config/rofi/theme.rasi"

configuration {
}

* {
  background-color: transparent;
  text-color: @fg;
  font: "GeistMono Nerd Font Medium 10";
  spacing: 0;
}

window {
  background-color: @bg-alt;
  border: 1px solid;
  border-color: @border;
  border-radius: 10px;
  padding: 0;
  width: 200px;
  location: center;
  y-offset: 0;
}

mainbox {
  padding: 8px;
  spacing: 0;
  border: 0;
}

inputbar {
  enabled: false;
}

listview {
  padding: 0;
  spacing: 4px;
  lines: 4;
  fixed-height: true;
  scrollbar: false;
  border: 0;
  dynamic: false;
}

element {
  padding: 10px 14px;
  spacing: 0;
  border: 0;
  border-radius: 10px;
  background-color: transparent;
  text-color: @fg;
  children: [element-text];
}

element normal.normal {
  background-color: transparent;
  text-color: @fg;
}

element alternate.normal {
  background-color: transparent;
  text-color: @fg;
}

element selected.normal {
  background-color: @bg-selected;
  text-color: @fg;
}

element-text {
  background-color: transparent;
  text-color: inherit;
  vertical-align: 0.5;
  horizontal-align: 0.5;
  font: "GeistMono Nerd Font Medium 12";
}

message {
  enabled: false;
}

scrollbar {
  enabled: false;
}

sidebar {
  enabled: false;
}

button {
  enabled: false;
}

mode-switcher {
  enabled: false;
}
