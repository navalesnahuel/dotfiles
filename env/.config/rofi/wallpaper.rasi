@import "~/.config/rofi/theme.rasi"

* {
  background-color: transparent;
  text-color: @fg;
  font: "GeistMono Nerd Font Medium 11";
  spacing: 0;
}

window {
  background-color: @bg-alt;
  border: 1px solid;
  border-color: @border;
  border-radius: 10px;
  padding: 0;
  width: 46%;
  location: center;
}

mainbox {
  padding: 16px;
  spacing: 14px;
  border: 0;
}

inputbar {
  padding: 6px 10px 12px 10px;
  spacing: 10px;
  background-color: transparent;
  text-color: @fg;
  border: 0px 0px 1px 0px solid;
  border-color: @border;
  margin: 0;
  children: [ prompt, entry ];
}

prompt {
  enabled: true;
  text-color: @prompt;
  str: " ";
  vertical-align: 0.5;
}

entry {
  text-color: @fg;
  placeholder-color: @info;
  placeholder: "";
  vertical-align: 0.5;
}

listview {
  padding: 4px;
  spacing: 16px;
  columns: 4;
  lines: 2;
  fixed-height: true;
  scrollbar: false;
  border: 0;
  flow: horizontal;
  dynamic: false;
}

element {
  orientation: vertical;
  padding: 6px;
  spacing: 8px;
  border: 2px solid;
  border-color: transparent;
  border-radius: 10px;
  background-color: @bg;
  text-color: @fg;
}

element normal.normal {
  background-color: @bg;
  text-color: @fg;
}

element selected.normal {
  background-color: @bg-selected;
  text-color: @fg;
  border-color: @prompt;
}

element-icon {
  background-color: transparent;
  size: 7em;
  border-radius: 10px;
  horizontal-align: 0.5;
  vertical-align: 0.5;
}

element-text {
  background-color: transparent;
  text-color: inherit;
  horizontal-align: 0.5;
  vertical-align: 0.5;
}
